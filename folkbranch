#!/bin/sh
# Runs a server command inside the running app, for example: ./folkbranch token create --name my-agent
# ./folkbranch connect   makes a key and connects the agent programs found on this computer over MCP.
# ./folkbranch open      opens the app in the browser, signed in, starting it first if needed.
# An install without Docker also has start, stop, restart, status, logs and share.
cd "$(dirname "$0")" || exit 1

# On a server the app runs as its own user, and its files must stay that user's, whoever types the command.
if [ -f .server ] && [ "$(id -u)" = 0 ] && [ "$(cat .server)" != root ]; then
  case "${1:-}" in
    start|stop|restart) ;;
    *) HOME=$PWD exec runuser -u "$(cat .server)" -- "$PWD/folkbranch" "$@" ;;
  esac
fi
ctl() { if [ "$(id -u)" = 0 ]; then systemctl "$@"; else sudo systemctl "$@"; fi; }

if [ -f .local ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue ;; *=*) ;; *) continue ;; esac
    name=${line%%=*}
    case "$name" in ''|*[!A-Za-z0-9_]*) continue ;; esac
    val=${line#*=}
    case "$val" in \"*\") val=${val#\"}; val=${val%\"} ;; \'*\') val=${val#\'}; val=${val%\'} ;; esac
    export "$name=$val"
  done < .env
  PORT=${PORT:-3000}
  BIND=${BIND:-127.0.0.1}
  export DATA_DIR="$PWD/data" PORT NODE_ENV=production HOSTNAME="$BIND"
  host=$BIND
  [ "$host" = 0.0.0.0 ] && host=127.0.0.1

  if [ -x runtime/node ]; then NODE=$PWD/runtime/node; else NODE=$(command -v node 2>/dev/null || true); fi
  [ -n "$NODE" ] || { echo "Node is gone from this computer. Run the install command again: it brings its own."; exit 1; }
fi

# Is this our process? A number in a file alone could by now belong to anything.
running() {
  if [ -f .server ]; then systemctl is-active --quiet folkbranch; return; fi
  [ -f folkbranch.pid ] || return 1
  pid=$(cat folkbranch.pid)
  [ -n "$pid" ] && ps -p "$pid" -o command= 2>/dev/null | grep -q 'folkbranch _run'
}

# Restoring a copy ends the process and counts on something to start it again, as Docker does.
# So does a crash, up to a point: one that keeps failing at once stops here, and the log says why.
supervise() {
  child=""
  trap '[ -n "$child" ] && kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; exit 0' TERM INT
  fails=0
  while :; do
    began=$(date +%s)
    (cd app && exec "$NODE" server.js) </dev/null &
    child=$!
    wait "$child"
    code=$?
    [ "$code" = 0 ] && exit 0
    if [ $(($(date +%s) - began)) -lt 10 ]; then fails=$((fails + 1)); else fails=0; fi
    [ "$fails" -ge 5 ] && { echo "Stopped restarting: the app failed $fails times in a row."; exit 1; }
    sleep 1
  done
}

start() {
  if running; then echo "Running at $BETTER_AUTH_URL"; return 0; fi
  # Whatever answers there is not us. Only "connection refused" means the port is free.
  curl -s -m 2 -o /dev/null "http://$host:$PORT/"
  if [ $? != 7 ]; then
    echo "Port $PORT is in use by another program. Stop that program, or move this one with the install command and --port 8080."
    return 1
  fi
  if [ -f .server ]; then
    ctl start folkbranch || return 1
    [ -f .no-caddy ] || ctl start folkbranch-caddy || return 1
  else
    mkdir -p data logs
    nohup "$PWD/folkbranch" _run </dev/null >> logs/folkbranch.log 2>&1 &
    echo $! > folkbranch.pid
  fi
  printf "Waiting for the app"
  i=0
  until curl -fs -m 2 -o /dev/null "http://$host:$PORT/api/health"; do
    i=$((i + 1))
    # A service between its restarts is not running for a moment, so there only the time decides.
    if { [ ! -f .server ] && ! running; } || [ "$i" -gt 60 ]; then
      echo; echo "It did not start. The end of logs/folkbranch.log:"; tail -n 15 logs/folkbranch.log
      stop >/dev/null
      return 1
    fi
    printf "."
    sleep 1
  done
  echo
  echo "Running at $BETTER_AUTH_URL"
}

# Is the tunnel ours and alive? As with the app: a number in a file alone proves nothing.
sharing() {
  [ -f share.pid ] || return 1
  spid=$(cat share.pid)
  [ -n "$spid" ] && ps -p "$spid" -o command= 2>/dev/null | grep -q 'tunnel'
}

unshare() {
  if sharing; then kill "$spid" 2>/dev/null; fi
  rm -f share.pid data/public-address
}

cloudflared_path() {
  if [ -n "${FOLKBRANCH_CLOUDFLARED:-}" ]; then printf '%s' "$FOLKBRANCH_CLOUDFLARED"; return; fi
  if [ -x runtime/cloudflared ]; then printf '%s' "$PWD/runtime/cloudflared"; return; fi
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) f=cloudflared-darwin-arm64.tgz ;;
    Darwin-x86_64) f=cloudflared-darwin-amd64.tgz ;;
    Linux-x86_64) f=cloudflared-linux-amd64 ;;
    Linux-aarch64|Linux-arm64) f=cloudflared-linux-arm64 ;;
    *) echo "No tunnel program for this computer." >&2; return 1 ;;
  esac
  echo "Getting cloudflared, about 20 MB, kept inside this folder." >&2
  mkdir -p runtime
  curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/$f" -o runtime/cloudflared.download || { echo "Could not download it." >&2; return 1; }
  case "$f" in
    *.tgz) tar -xzf runtime/cloudflared.download -C runtime cloudflared; rm -f runtime/cloudflared.download ;;
    *) mv runtime/cloudflared.download runtime/cloudflared ;;
  esac
  chmod +x runtime/cloudflared
  printf '%s' "$PWD/runtime/cloudflared"
}

# Lets a relative's phone reach this computer, while it stays on. Nothing here decides for the person: the archive
# gets one more way in from the whole internet, so they say yes to that, in words, every time.
share() {
  if [ -f .server ]; then echo "This server already has an address: $BETTER_AUTH_URL"; return 0; fi
  case "${1:-}" in
    stop) unshare; echo "The outside address is closed."; return 0 ;;
    status) if sharing; then cat data/public-address; echo; else echo "Not shared."; return 1; fi; return 0 ;;
  esac
  if sharing; then echo "Already shared at: $(cat data/public-address)"; return 0; fi
  echo "This gives the app an address on the internet, through Cloudflare, until you run ./folkbranch share stop."
  echo "The archive stays behind its sign-in, but Cloudflare carries the traffic, and anyone with a link you made can use it."
  if [ "${1:-}" != --yes ]; then
    if [ ! -t 0 ]; then echo "Say yes first: ./folkbranch share --yes"; return 1; fi
    printf "Open it? Type yes: "
    read -r answer
    [ "$answer" = yes ] || { echo "Nothing was opened."; return 1; }
  fi
  start >/dev/null || { echo "The app did not start: ./folkbranch start"; return 1; }
  tool=$(cloudflared_path) || return 1
  mkdir -p logs
  : > logs/share.log
  nohup "$tool" tunnel --no-autoupdate --url "http://$host:$PORT" </dev/null >> logs/share.log 2>&1 &
  echo $! > share.pid
  i=0
  until addr=$(grep -Eo 'https://[a-z0-9-]+\.trycloudflare\.com' logs/share.log | head -n 1) && [ -n "$addr" ]; do
    i=$((i + 1))
    if ! sharing || [ "$i" -gt 40 ]; then echo "The tunnel did not open. The end of logs/share.log:"; tail -n 8 logs/share.log; unshare; return 1; fi
    sleep 1
  done
  printf '%s' "$addr" > data/public-address
  echo
  echo "Outside address: $addr"
  echo "Links you make in the app now lead there. It changes each time. To close it: ./folkbranch share stop"
}

stop() {
  if [ -f .server ]; then ctl stop folkbranch && echo "Stopped."; return; fi
  unshare
  if ! running; then rm -f folkbranch.pid; echo "Not running."; return 0; fi
  kill "$pid"
  i=0
  while ps -p "$pid" >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -gt 30 ] && { echo "It did not stop. Process $pid is still running."; return 1; }
    sleep 1
  done
  rm -f folkbranch.pid
  echo "Stopped."
}

status() {
  if running; then
    echo "Running at $BETTER_AUTH_URL"
    echo "Data: $DATA_DIR"
  else
    echo "Stopped. Start it with: ./folkbranch start"
    return 1
  fi
}

logs() {
  [ -f logs/folkbranch.log ] || { echo "No log yet."; return 0; }
  if [ -t 1 ]; then exec tail -n 100 -f logs/folkbranch.log; else tail -n 100 logs/folkbranch.log; fi
}

# Nothing to open on a server or in a test: there the address is printed instead.
browse() {
  [ -z "${FOLKBRANCH_NO_OPEN:-}${CI:-}${SSH_CONNECTION:-}" ] && [ ! -f .server ] || return 1
  case "$(uname -s)" in
    Darwin) command -v open >/dev/null 2>&1 && open "$1" ;;
    *) [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null 2>&1 && xdg-open "$1" >/dev/null 2>&1 ;;
  esac
}

open_app() {
  if [ -f .local ]; then
    start >/dev/null || { echo "The app did not start: ./folkbranch start"; exit 1; }
    cli() { "$NODE" app/folkbranch.mjs "$@"; }
  else
    cli() { docker compose exec -T folkbranch node folkbranch.mjs "$@"; }
    BETTER_AUTH_URL=$(sed -n 's/^BETTER_AUTH_URL=//p' .env | head -n 1)
    SETUP_TOKEN=$(sed -n 's/^SETUP_TOKEN=//p' .env | head -n 1)
  fi
  info=$(cli doctor </dev/null) || { echo "$info"; echo "Is the app running? Start it with: docker compose up -d"; exit 1; }
  if printf '%s\n' "$info" | grep -q '^Users:   0'; then
    url="$BETTER_AUTH_URL/setup?code=$SETUP_TOKEN"
  else
    # Signing in on opening is for this computer: elsewhere the link could be opened by a messenger's preview.
    case "$BETTER_AUTH_URL" in http://localhost:*|http://127.0.0.1:*) now=--now ;; *) now="" ;; esac
    url=$(cli login-link $now </dev/null | sed -n 's/^ *\(http[^ ]*\)$/\1/p')
  fi
  [ -n "$url" ] || { echo "Could not make a sign-in link."; exit 1; }
  if browse "$url"; then echo "Opened in your browser."; else echo "Open this address. A sign-in link works once:"; echo; echo "  $url"; fi
}

connect() {
  name="agent-$(hostname -s 2>/dev/null || echo here)"
  if [ -f .local ]; then
    start >/dev/null || { echo "The app is not running, and it did not start: ./folkbranch start"; exit 1; }
    out=$("$NODE" app/folkbranch.mjs token create --name "$name" --role editor --json) || { echo "$out"; exit 1; }
  else
    out=$(docker compose exec -T folkbranch node folkbranch.mjs token create --name "$name" --role editor --json) || { echo "$out"; echo "Is the app running? Start it with: docker compose up -d"; exit 1; }
  fi
  token=$(printf '%s' "$out" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
  url=$(printf '%s' "$out" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
  done=""
  if command -v claude >/dev/null 2>&1; then
    claude mcp add --scope user --transport http folkbranch "$url" --header "Authorization: Bearer $token" && done="$done Claude Code"
  fi
  if command -v codex >/dev/null 2>&1; then
    if codex mcp add folkbranch --url "$url" --bearer-token-env-var FOLKBRANCH_TOKEN; then
      done="$done Codex"
      echo "Codex reads the key from your shell. Add this line to ~/.zshrc or ~/.bashrc:"
      echo
      echo "  export FOLKBRANCH_TOKEN=$token"
      echo
    fi
  fi
  if [ -n "$done" ]; then echo "Connected:$done. Edits wait for your review in the app."; return; fi
  echo "No Claude Code or Codex here. For Cursor, Windsurf or another MCP client, use:"
  echo
  printf '  {"mcpServers":{"folkbranch":{"type":"http","url":"%s","headers":{"Authorization":"Bearer %s"}}}}\n' "$url" "$token"
  echo
  echo "On another computer, use its address instead of localhost. The app shows all of this: Settings > Agents and MCP."
}

[ "${1:-}" = connect ] && { connect; exit 0; }
[ "${1:-}" = open ] && { open_app; exit 0; }
[ "${1:-}" = _browse ] && { browse "$2"; exit $?; }
if [ -f .local ]; then
  case "${1:-}" in
    _run) supervise; exit $? ;;
    start) start; exit $? ;;
    stop) stop; exit $? ;;
    restart) stop && start; exit $? ;;
    status) status; exit $? ;;
    logs) logs; exit $? ;;
    share) share "${2:-}"; exit $? ;;
    ''|help|--help)
      echo "Folkbranch, this computer"
      echo
      echo "  open               Open the app in the browser, signed in"
      echo "  start, stop, restart, status, logs"
      [ -f .server ] || echo "  share              Give the app an address on the internet, so a relative's link opens"
      echo "  connect            Connect Claude Code or Codex over MCP"
      echo
      ;;
  esac
  exec "$NODE" app/folkbranch.mjs "$@"
fi
[ -t 0 ] && [ -t 1 ] && exec docker compose exec folkbranch node folkbranch.mjs "$@"
exec docker compose exec -T folkbranch node folkbranch.mjs "$@"
