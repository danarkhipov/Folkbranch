# ./install.sh writes .env for you. Everything here is optional for local use.

# Public address, with https on a server. Sign-in checks it, so it must match what people open.
BETTER_AUTH_URL=https://family.example.com
# Domain for automatic HTTPS (docker compose --profile https).
DOMAIN=family.example.com
# Where the port listens. Keep 127.0.0.1 behind HTTPS; plain HTTP is not safe on the open internet.
BIND=127.0.0.1
PORT=3000

# Signs sessions and encrypts the assistant's key. Generated into the data folder when empty.
# On a hosting platform set your own, so a copy of the volume alone cannot decrypt the key. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Protects the empty instance: the first person needs this code. Generated and logged when empty.
SETUP_TOKEN=
# The owner's way back in: open /invite/<RECOVERY_TOKEN>. ./family login-link does the same.
RECOVERY_TOKEN=

# The built-in assistant. It stays off until the owner turns it on, and without a key it cannot run.
# What it reads is sent to this provider.
# One key is enough; the first one set is used unless AGENT_PROVIDER names one.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# AGENT_PROVIDER=anthropic | openrouter | openai | google | local
# The owner can also paste a key in the assistant's panel, kept encrypted in the database. A key here wins.
# AGENT_MODEL is needed for openai, google and local. Defaults are cheap: claude-haiku-5-5, z-ai/glm-5.3-flash.
# AGENT_MODEL=
# local means Ollama, LM Studio and the like: nothing leaves your server.
# AGENT_BASE_URL=http://host.docker.internal:11434/v1

# Optional sign-in with these providers, for people who already have an account here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
