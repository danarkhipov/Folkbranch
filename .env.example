# Everything is optional. Without any of this, the app runs on invitation links alone.
DATA_DIR=/data
# Public address, used for OAuth callbacks. Railway fills RAILWAY_PUBLIC_DOMAIN itself.
BETTER_AUTH_URL=https://family.example.com
# Generated into DATA_DIR on first run when not set.
BETTER_AUTH_SECRET=
# Protects the empty instance: the first run asks for this code.
SETUP_TOKEN=
# The owner's way back in: open /invite/<RECOVERY_TOKEN>.
RECOVERY_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
